[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/ui/HUD.gd" id="1"]

[node name="HUD" type="CanvasLayer"]
script = ExtResource("1")

; VBoxRoot fills the entire viewport. Spacer expands to push BottomBar to the bottom.
; BottomBar is a Container child (layout_mode=2) so the editor never writes anchors_preset for it.
[node name="VBoxRoot" type="VBoxContainer" parent="."]
anchor_right = 1.0
anchor_bottom = 1.0

[node name="Spacer" type="Control" parent="VBoxRoot"]
layout_mode = 2
size_flags_vertical = 3

[node name="BottomBar" type="PanelContainer" parent="VBoxRoot"]
layout_mode = 2
custom_minimum_size = Vector2(0, 64)

[node name="Margins" type="MarginContainer" parent="VBoxRoot/BottomBar"]
layout_mode = 2
theme_override_constants/margin_left = 12
theme_override_constants/margin_top = 8
theme_override_constants/margin_right = 12
theme_override_constants/margin_bottom = 8

[node name="HBox" type="HBoxContainer" parent="VBoxRoot/BottomBar/Margins"]
layout_mode = 2

[node name="TurnLabel" type="Label" parent="VBoxRoot/BottomBar/Margins/HBox"]
layout_mode = 2
unique_name_in_owner = true
custom_minimum_size = Vector2(220, 0)
size_flags_vertical = 4
text = "Your Turn"
vertical_alignment = 1

[node name="InfoArea" type="Control" parent="VBoxRoot/BottomBar/Margins/HBox"]
layout_mode = 2
size_flags_horizontal = 3

[node name="ThreatToggleButton" type="Button" parent="VBoxRoot/BottomBar/Margins/HBox"]
layout_mode = 2
unique_name_in_owner = true
custom_minimum_size = Vector2(160, 0)
text = "Danger Zone: ON"

[node name="EndTurnButton" type="Button" parent="VBoxRoot/BottomBar/Margins/HBox"]
layout_mode = 2
unique_name_in_owner = true
custom_minimum_size = Vector2(120, 0)
text = "End Turn"

; ResultPanel sits outside VBoxRoot so it can overlay the full screen.
[node name="ResultPanel" type="Panel" parent="."]
unique_name_in_owner = true
visible = false
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -200.0
offset_top = -110.0
offset_right = 200.0
offset_bottom = 110.0
custom_minimum_size = Vector2(400, 220)

[node name="VBox" type="VBoxContainer" parent="ResultPanel"]
layout_mode = 0
offset_left = 16.0
offset_top = 16.0
offset_right = 384.0
offset_bottom = 204.0

[node name="ResultLabel" type="Label" parent="ResultPanel/VBox"]
layout_mode = 2
unique_name_in_owner = true
text = "Result"
horizontal_alignment = 1

[node name="ContinueButton" type="Button" parent="ResultPanel/VBox"]
layout_mode = 2
unique_name_in_owner = true
text = "Continue"
