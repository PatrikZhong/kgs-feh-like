; Engine configuration file.
; It's best edited using the editor UI and not directly,
; but the grammar and target are simple enough to do it by hand.

config_version=5

[application]

config/name="kgs-feh-like"
config/description="A fast-paced tactical RPG inspired by Fire Emblem Heroes and blitz chess."
config/version="0.1"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.x", "Forward Plus")

[autoload]

TurnManager="*res://scripts/battle/TurnManager.gd"
EnemyAI="*res://scripts/battle/EnemyAI.gd"
CombatResolver="*res://scripts/battle/CombatResolver.gd"
SaveData="*res://scripts/data/SaveData.gd"

[rendering]

renderer/rendering_method="forward_plus"
